# SEER Clinical DR Screening Pipeline — Configuration Environment

# ----------------- Server & Network -----------------
PORT=4000
SECRET_KEY=seer-jwt-secret-replace-in-production

# ----------------- Primary Database (PostgreSQL) -----------------
# Central server/cloud database for tele-ophthalmology synchronisation
DATABASE_URL=postgresql://user:password@localhost:5432/seer_retina
POSTGRES_URL=postgresql://user:password@localhost:5432/seer_retina

# ----------------- Offline-First Database (SQLite) -----------------
# Embedded local database for offline PHC operations
SQLITE_PATH=./data/seer_offline.sqlite

# ----------------- MATLAB Engine Configuration -----------------
# Path to local MATLAB executable (e.g. C:\Program Files\MATLAB\R2024a\bin\matlab.exe)
# If empty or not installed, the service utilizes the integrated scientific engine fallback
MATLAB_PATH=
MATLAB_TIMEOUT_MS=30000

# ----------------- Model & Storage Paths -----------------
DATA_ROOT=./data
APTOS_PATH=./data/aptos2019
IDRID_PATH=./data/idrid
DRIVE_PATH=./data/drive
MESSIDOR2_PATH=./data/messidor2

MODEL_PATH=../models/dr_classifier/model_v1
UPLOAD_PATH=./uploads

# ----------------- Clinical Thresholds -----------------
RETAKE_THRESHOLD=65
CONFIDENCE_FLOOR=70
DECISION_THRESHOLD_REFERABLE=0.50

# ----------------- Vision Provider (Optional cloud secondary) -----------------
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=gemini-3-flash
VISION_TIMEOUT_MS=30000
