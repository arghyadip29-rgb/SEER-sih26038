# Drishti context layer — config
# Copy to .env to point the pipeline at a real vision API.
# Without these, the pipeline runs on the deterministic mock provider
# (same packet, same rules) so the demo works fully offline.

# ---- Recommended: Gemini Flash (primary) ----
# Why: 1M-token context swallows anchor-heavy packets, native vision + JSON
# mode, fastest TTFT in its class, and ~$0.50/$3.00 per M tokens — about
# $220/yr at 100,000 cases (vs ~$1,000 on GPT-4o, ~$3,200+ on flagships).
# Google's OpenAI-compatible endpoint plugs into the adapter unchanged.
# Verify the model ID + prices before buying (they move quarterly).
# VISION_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# VISION_API_KEY=AIzaSy...
# VISION_MODEL=gemini-3-flash
#
# ---- Working preset: OpenRouter + Gemini Flash (verified live) ----
# VISION_API_URL=https://openrouter.ai/api/v1/chat/completions
# VISION_API_KEY=sk-or-v1-...
# VISION_MODEL=google/gemini-3.8-flash
# VISION_TIMEOUT_MS=60000
#
# ---- Challenger for the ablation (same adapter, swap these two lines) ----
# GPT-5.6 Luna: cheapest credible OpenAI tier ($0.20/$1.20), good enough to
# test whether the packet matters more than the provider.
# VISION_API_URL=https://api.openai.com/v1/chat/completions
# VISION_MODEL=gpt-5.6-luna
#
# ---- Skip for now ----
# Flagships (GPT-6 Astra / Claude Fable, $10/$50): 15-50x the cost for
# unproven grading gain. Claude's newer tokenizers also inflate token
# counts ~30%. Revisit only if the ablation shows Flash failing.
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=gemini-3-flash
VISION_TIMEOUT_MS=30000

# L5 thresholds
RETAKE_THRESHOLD=65
CONFIDENCE_FLOOR=70

PORT=4000
